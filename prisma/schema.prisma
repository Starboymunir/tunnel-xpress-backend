generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────

enum Role {
  CUSTOMER
  RIDER
  ADMIN
}

enum AuthProvider {
  EMAIL
  PHONE
  GOOGLE
}

enum DeliveryStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  FINDING_RIDER
  RIDER_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  FAILED
}

enum RiderType {
  BIKE
  CAR
  VAN
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  OPAY
  WALLET
}

enum NotificationType {
  ORDER
  PROMO
  SYSTEM
  PAYMENT
  RIDER
  REFERRAL
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum RiderAvailability {
  ONLINE
  OFFLINE
  BUSY
}

enum VerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

// ─── USER ───────────────────────────────────────────────

model User {
  id            String       @id @default(uuid())
  email         String?      @unique
  phone         String?      @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  avatarUrl     String?
  role          Role         @default(CUSTOMER)
  authProvider  AuthProvider  @default(EMAIL)
  isEmailVerified Boolean    @default(false)
  isPhoneVerified Boolean    @default(false)
  isActive      Boolean      @default(true)
  referralCode  String       @unique @default(uuid())
  referredBy    String?
  customerRating      Float    @default(0)
  customerRatingCount Int      @default(0)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  settings       UserSettings?
  deliveries     Delivery[]     @relation("CustomerDeliveries")
  payments       Payment[]
  notifications  Notification[]
  savedLocations SavedLocation[]
  savedCards     SavedCard[]
  referrals      Referral[]     @relation("Referrer")
  referredUsers  Referral[]     @relation("Referred")
  ratings        Rating[]       @relation("RaterUser")
  ratingsReceived Rating[]      @relation("RatedUser")
  supportChats   SupportChat[]
  riderProfile   RiderProfile?
  wallet         Wallet?

  @@map("users")
}

model UserSettings {
  id                String  @id @default(uuid())
  userId            String  @unique
  pushNotifications Boolean @default(true)
  emailNotifications Boolean @default(true)
  smsNotifications  Boolean @default(true)
  biometricLogin    Boolean @default(false)
  language          String  @default("en")
  darkMode          Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ─── RIDER PROFILE ──────────────────────────────────────

model RiderProfile {
  id              String            @id @default(uuid())
  userId          String            @unique
  vehicleType     RiderType         @default(BIKE)
  plateNumber     String?
  vehicleColor    String?
  licenseNumber   String?
  availability    RiderAvailability @default(OFFLINE)
  currentLat      Float?
  currentLng      Float?
  lastLocationAt  DateTime?
  totalDeliveries Int               @default(0)
  avgRating       Float             @default(0)
  ratingCount     Int               @default(0)
  isApproved      Boolean           @default(false)
  verificationStatus VerificationStatus @default(NONE)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries    Delivery[]          @relation("RiderDeliveries")
  ratings       Rating[]            @relation("RatedRider")
  verification  RiderVerification?
  earnings      RiderEarning[]
  payouts       Payout[]
  payoutAccount RiderPayoutAccount?

  @@map("rider_profiles")
}

// ─── RIDER EARNINGS / PAYOUTS ───────────────────────────

enum EarningStatus {
  PENDING
  PAID
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum PayoutAccountStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

// One ledger row per delivered order — the rider's commission for that trip.
model RiderEarning {
  id             String        @id @default(uuid())
  riderProfileId String
  deliveryId     String        @unique
  amount         Float
  distanceKm     Float         @default(0)
  status         EarningStatus @default(PENDING)
  payoutId       String?
  createdAt      DateTime      @default(now())
  paidAt         DateTime?

  rider    RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Cascade)
  delivery Delivery     @relation(fields: [deliveryId], references: [id])
  payout   Payout?      @relation(fields: [payoutId], references: [id])

  @@index([riderProfileId, status])
  @@map("rider_earnings")
}

// The rider's bank (NUBAN) destination for payouts.
model RiderPayoutAccount {
  id             String              @id @default(uuid())
  riderProfileId String              @unique
  accountNumber  String
  bankCode       String
  bankName       String
  accountName    String
  last4          String
  status         PayoutAccountStatus @default(UNVERIFIED)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  rider RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Cascade)

  @@map("rider_payout_accounts")
}

// A settled batch of earnings paid out to the rider.
model Payout {
  id              String       @id @default(uuid())
  riderProfileId  String
  reference       String       @unique
  amount          Float
  status          PayoutStatus @default(PENDING)
  payoutAccountId String?
  periodMonth     String?
  createdAt       DateTime     @default(now())
  paidAt          DateTime?

  rider    RiderProfile   @relation(fields: [riderProfileId], references: [id], onDelete: Cascade)
  earnings RiderEarning[]

  @@index([riderProfileId, createdAt])
  @@map("payouts")
}

// ─── RIDER KYC / VERIFICATION ───────────────────────────

model RiderVerification {
  id             String             @id @default(uuid())
  riderProfileId String             @unique
  status         VerificationStatus @default(PENDING)

  // Personal details
  fullName     String
  dateOfBirth  String
  homeAddress  String?
  phone        String?

  // Government ID
  idType     String
  idFrontUrl String
  idBackUrl  String?

  // Selfie
  selfieUrl String

  // Rider permit
  permitType   String
  permitNumber String
  permitExpiry String
  permitUrl    String

  // Vehicle
  plateNumber     String
  vehicleColor    String?
  vehiclePhotoUrl String?

  rejectionReason String?
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riderProfile RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Cascade)

  @@map("rider_verifications")
}

// ─── DELIVERY / ORDER ───────────────────────────────────

model Delivery {
  id              String         @id @default(uuid())
  orderTag        String         @unique
  customerId      String
  riderId         String?
  status          DeliveryStatus @default(DRAFT)

  // Pickup
  pickupAddress   String
  pickupLat       Float
  pickupLng       Float
  pickupContactName  String?
  pickupContactPhone String?
  pickupNote      String?

  // Dropoff
  dropoffAddress  String
  dropoffLat      Float
  dropoffLng      Float
  dropoffContactName  String?
  dropoffContactPhone String?
  dropoffNote     String?

  // Package
  packageName     String
  packageDescription String?
  packageImageUrl    String?
  riderType       RiderType      @default(BIKE)
  specialInstructions String?

  // Pricing
  distanceKm      Float          @default(0)
  baseFee         Float          @default(0)
  perKmFee        Float          @default(0)
  surgeMultiplier Float          @default(1.0)
  totalFee        Float          @default(0)
  couponId        String?
  discountAmount  Float          @default(0)

  // Timestamps
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  paidAt          DateTime?
  assignedAt      DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?

  // Tracking
  estimatedMinutes Int?
  liveRiderLat     Float?
  liveRiderLng     Float?

  // Hand-off verification codes (rider must enter these at pickup/dropoff)
  pickupCode       String?
  dropoffCode      String?

  // Riders who declined this request (excluded from their available list)
  declinedRiderIds String[]      @default([])

  // Rider's rating of the customer for this trip
  riderRatedScore   Int?
  riderRatedComment String?

  // Relations
  customer  User          @relation("CustomerDeliveries", fields: [customerId], references: [id])
  rider     RiderProfile? @relation("RiderDeliveries", fields: [riderId], references: [id])
  payment   Payment?
  ratings   Rating[]
  coupon    Coupon?       @relation(fields: [couponId], references: [id])
  riderEarning RiderEarning?

  @@index([customerId])
  @@index([riderId])
  @@index([status])
  @@index([orderTag])
  @@map("deliveries")
}

// ─── PAYMENT ────────────────────────────────────────────

model Payment {
  id              String        @id @default(uuid())
  deliveryId      String        @unique
  userId          String
  amount          Float
  currency        String        @default("NGN")
  method          PaymentMethod @default(CARD)
  status          PaymentStatus @default(PENDING)
  paystackRef     String?       @unique
  paystackAuthCode String?
  metadata        Json?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  delivery Delivery @relation(fields: [deliveryId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([paystackRef])
  @@map("payments")
}

model SavedCard {
  id            String  @id @default(uuid())
  userId        String
  last4         String
  brand         String
  expMonth      Int
  expYear       Int
  authCode      String
  isDefault     Boolean @default(false)
  bank          String?

  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_cards")
}

model Wallet {
  id       String @id @default(uuid())
  userId   String @unique
  balance  Float  @default(0)
  currency String @default("NGN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Coupon {
  id              String   @id @default(uuid())
  code            String   @unique
  discountPercent Float?
  discountFlat    Float?
  maxUses         Int      @default(100)
  currentUses     Int      @default(0)
  minOrderAmount  Float    @default(0)
  expiresAt       DateTime
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())

  deliveries Delivery[]

  @@map("coupons")
}

// ─── RATING ─────────────────────────────────────────────

enum RatingType {
  RIDER     // a customer rating the rider on a delivery
  CUSTOMER  // a rider rating the customer on a delivery
  APP       // either party rating the app experience
}

model Rating {
  id             String     @id @default(uuid())
  type           RatingType @default(RIDER)
  deliveryId     String?
  raterId        String     // who submitted the rating
  ratedUserId    String?    // the User being rated (customer, or the rider's user)
  riderProfileId String?    // the RiderProfile being rated (type RIDER)
  score          Int        // 1-5
  comment        String?

  createdAt      DateTime   @default(now())

  delivery     Delivery?     @relation(fields: [deliveryId], references: [id])
  rater        User          @relation("RaterUser", fields: [raterId], references: [id])
  ratedUser    User?         @relation("RatedUser", fields: [ratedUserId], references: [id])
  riderProfile RiderProfile? @relation("RatedRider", fields: [riderProfileId], references: [id])

  // One rating per (delivery, type, rater): a customer can't rate the same rider
  // twice, but the customer + rider + app ratings for one delivery coexist.
  @@unique([deliveryId, type, raterId])
  @@index([riderProfileId])
  @@index([ratedUserId])
  @@map("ratings")
}

// ─── NOTIFICATIONS ──────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)

  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── SAVED LOCATIONS ────────────────────────────────────

model SavedLocation {
  id        String  @id @default(uuid())
  userId    String
  label     String
  address   String
  lat       Float
  lng       Float
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_locations")
}

// ─── REFERRALS ──────────────────────────────────────────

enum ReferralStatus {
  PENDING
  JOINED
  COMPLETED
}

model Referral {
  id          String         @id @default(uuid())
  referrerId  String
  referredId  String
  bonusAmount Float          @default(0)
  isPaid      Boolean        @default(false)
  status      ReferralStatus @default(PENDING)
  completedAt DateTime?

  createdAt   DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id])
  referred User @relation("Referred", fields: [referredId], references: [id])

  @@unique([referrerId, referredId])
  @@map("referrals")
}

// ─── SUPPORT ────────────────────────────────────────────

model SupportChat {
  id        String              @id @default(uuid())
  userId    String
  subject   String
  status    SupportTicketStatus @default(OPEN)

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  messages SupportMessage[]

  @@index([userId])
  @@map("support_chats")
}

model SupportMessage {
  id        String  @id @default(uuid())
  chatId    String
  senderId  String
  content   String
  isAgent   Boolean @default(false)

  createdAt DateTime @default(now())

  chat SupportChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@map("support_messages")
}

// ─── OTP ────────────────────────────────────────────────

model OTP {
  id        String   @id @default(uuid())
  identifier String  // email or phone
  code      String
  expiresAt DateTime
  isUsed    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([identifier, code])
  @@map("otps")
}

// ─── PROMO BANNERS ──────────────────────────────────────

model PromoBanner {
  id        String   @id @default(uuid())
  slug      String?  @unique
  title     String
  subtitle  String?
  body      String?
  imageUrl  String?
  illustration String?
  linkUrl   String?
  ctaLabel  String?
  ctaDeepLink String?
  theme     String?  // teal | magenta | deepViolet | violet | lime
  audience  String   @default("ALL") // ALL | RIDER | CUSTOMER
  isActive  Boolean  @default(true)
  priority  Int      @default(0)
  sortOrder Int      @default(0)

  createdAt DateTime  @default(now())
  validFrom DateTime?
  expiresAt DateTime?

  @@index([audience, isActive])
  @@map("promo_banners")
}

// ─── DELIVERY CHAT (customer ↔ assigned rider) ──────────
model DeliveryMessage {
  id         String   @id @default(uuid())
  deliveryId String
  senderId   String
  senderRole String   // 'CUSTOMER' | 'RIDER'
  content    String
  createdAt  DateTime @default(now())

  @@index([deliveryId])
  @@map("delivery_messages")
}
